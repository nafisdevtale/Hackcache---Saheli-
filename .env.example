# ==============================================================================
# SAHELI INDIA: ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to configure local production/dev services.
# Note: Saheli core tracking works 100% offline without any server variables.
# These variables configure optional cloud/server integrations (AI, Community, Push).
# ==============================================================================

# --- AI HEALTH ASSISTANT CONFIGURATION ---
# Primary recommended provider: Google Gemini API (https://aistudio.google.com/)
AI_API_KEY=your_gemini_or_ai_api_key_here
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Optional generic OpenAI-compatible fallback:
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- SAFE COMMUNITY & MODERATION ---
# Secret token required to approve/reject community submissions in production
MODERATOR_SECRET=saheli_mod_secret_change_in_production

# Optional Supabase Database (defaults to in-memory store with synthetic seeds)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WEB PUSH & SCHEDULED DISCREET NOTIFICATIONS ---
# Web push keys generated via web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@saheliapp.in
