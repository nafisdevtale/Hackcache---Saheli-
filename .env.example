# ==============================================================================
# SAHELI INDIA: ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local to configure optional server integrations.
# Saheli core menstrual tracking and diary operate 100% locally and offline
# without requiring any server environment variables or online accounts.
# ==============================================================================

# DIVA and Eeve
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_API_KEY=

# FLASH
SERPAPI_API_KEY=

# INSTINCT
TMDB_API_TOKEN=
TMDB_API_KEY=
WATCHMODE_API_KEY=

# COMMUNITY
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MODERATOR_SECRET=

# REPORTS AND ISSUES
SAHELI_MAINTAINER_KEY=

# WEB PUSH
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@saheliapp.in
CRON_SECRET=
