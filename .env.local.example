# ==============================================================================
# SAHELI / FLASH — LOCAL ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.local on your own machine, then fill the values there.
# NEVER paste real secrets into this example or commit your .env.local file.
# Blank values intentionally disable optional integrations until configured.
# ==============================================================================

# --- FLASH: MENSTRUAL SELF-CARE PRODUCT RECOMMENDATIONS ---
# SerpApi dashboard: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- AI ASSISTANT (OPTIONAL) ---
# Gemini AI Studio: https://aistudio.google.com/
AI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider, only if the backend is configured for it:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- SUPABASE (OPTIONAL CLOUD FEATURES) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- COMMUNITY MODERATION ---
MODERATOR_SECRET=

# --- WEB PUSH / DISCREET NOTIFICATIONS ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- SCHEDULED TASKS / MAINTAINER ---
CRON_SECRET=
SAHELI_MAINTAINER_KEY=

# --- RETAILER AFFILIATE INTEGRATIONS (OPTIONAL) ---
# Only configure these if enrolled/approved and the corresponding integration exists.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
AMAZON_ASSOCIATES_TAG=
AMAZON_CREATORS_API_CREDENTIAL=

# Note: financial market APIs are not needed for FLASH menstrual-care recommendations.
