# Local development secrets for Saheli.
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or put secrets in VITE_* variables.

# --- FLASH / MENSTRUAL SELF-CARE PRODUCT SEARCH ---
# Create a key at https://serpapi.com/manage-api-key
# Used server-side only. Leave blank to disable live product search.
SERPAPI_API_KEY=

# Optional additional provider credentials (only fill these if implemented).
# AI / Health assistant
AI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# For an OpenAI-compatible provider, configure the provider and URL explicitly:
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- SUPABASE ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- COMMUNITY MODERATION ---
# Generate a long random secret for local/server use; do not use a sample value.
MODERATOR_SECRET=

# --- WEB PUSH ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@saheliapp.in

# --- SCHEDULED TASKS / MAINTAINER ---
# Keep empty unless the corresponding server route has been configured securely.
CRON_SECRET=
SAHELI_MAINTAINER_KEY=
