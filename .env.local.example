# SAHELI — LOCAL DEVELOPMENT SECRETS TEMPLATE
# Copy this file to .env.local on your own device.
# Never commit or upload the real .env.local file to GitHub.
# Replace blank values locally with keys obtained from each provider.
# Restart bun run dev after changing values.

# AI — Eeve, DIVA and other server-side AI routes
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Alternative supported alias (leave blank when using GEMINI_API_KEY)
AI_API_KEY=

# FLASH — menstrual self-care product search
# SerpApi: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# INSTINCT — movies and streaming metadata
TMDB_API_TOKEN=
# Alternative TMDB key (leave blank when using TMDB_API_TOKEN)
TMDB_API_KEY=
WATCHMODE_API_KEY=

# Moderated Community — server-side only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use only if your implementation explicitly requires a publishable/anon key
SUPABASE_ANON_KEY=
MODERATOR_SECRET=

# Feedback administration — server-side only
SAHELI_MAINTAINER_KEY=

# Web push — optional; local reminders do not require these
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# Partner Connect remote sync (optional; provider-specific config not yet integrated)
# Add only after durable encrypted object storage has been selected and implemented.

# Self Care, Discover local features, cycle tracking, app lock and file imports
# require no third-party API keys.
