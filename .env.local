# ==============================================================================
# SAHELI / FLASH — LOCAL ENVIRONMENT VARIABLES
# ==============================================================================
# Paste your own credentials after '='. Keep this file private.
# Do not commit real API keys. The .gitignore should exclude .env.local.
# Blank values mean the related optional integration is not configured.
#
# Note: This file is in the GitHub repository, so even blank placeholders are
# visible publicly. Do not ever fill this copy on GitHub with actual secrets.
# Create/edit .env.local on your own Mac instead.
# ==============================================================================

# --- FLASH: PERIOD SELF-CARE PRODUCT RECOMMENDATIONS ---
# SerpApi key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- AI ASSISTANT (OPTIONAL) ---
# Gemini: https://aistudio.google.com/
AI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider, if implemented/configured:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- SUPABASE (OPTIONAL CLOUD FEATURES) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- COMMUNITY MODERATION ---
MODERATOR_SECRET=

# --- WEB PUSH / NOTIFICATIONS ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- SCHEDULED TASKS / MAINTAINER TOOLS ---
CRON_SECRET=
SAHELI_MAINTAINER_KEY=

# --- RETAILER AFFILIATE APIS (OPTIONAL; ONLY IF ACCESS IS APPROVED) ---
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
AMAZON_ASSOCIATES_TAG=
AMAZON_CREATORS_API_CREDENTIAL=

# --- OPTIONAL FINANCIAL MARKET DATA (NOT REQUIRED BY FLASH PERIOD CARE) ---
# Leave blank; this is unrelated to menstrual self-care recommendations.
ALPHA_VANTAGE_API_KEY=
